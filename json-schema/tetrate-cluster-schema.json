{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Cluster",
  "title": "Cluster",
  "allOf": [
    {
      "$ref": "#/components/schemas/ResourceMeta"
    }
  ],
  "type": "object",
  "properties": {
    "spec": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tokenTtl": {
          "type": "string",
          "description": "TTL for the cluster service account token"
        },
        "network": {
          "type": "string",
          "description": "Network identifier for multi-network deployments"
        },
        "tier1Cluster": {
          "type": "boolean",
          "description": "Whether this cluster is a Tier-1 gateway cluster"
        }
      }
    }
  }
}